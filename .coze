[project]
name = "opencode"
requires = ["nodejs-24"]

[dev]
build = ["npm", "install"]
run = ["npx", "opencode", "serve", "--port", "5000", "--hostname", "0.0.0.0", "--print-logs"]

[deploy]
build = ["npm", "install"]
run = ["npx", "opencode", "serve", "--port", "5000", "--hostname", "0.0.0.0", "--print-logs"]
